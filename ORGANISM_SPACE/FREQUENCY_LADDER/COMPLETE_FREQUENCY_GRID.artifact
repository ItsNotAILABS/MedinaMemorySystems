    // Alpha
    8.0, 8.5, 9.0, 9.5, 10.0, 10.5, 11.0, 12.0, 13.0,
    // Beta
    14.0, 14.1, 15.0, 18.0, 20.0, 20.3, 22.0, 25.0, 26.4, 30.0,
    // Gamma
    32.4, 35.0, 39.0, 40.0, 45.0, 50.0, 60.0, 70.0, 80.0, 100.0,
    // Solfeggio
    174.0, 285.0, 396.0, 417.0, 432.0, 440.0, 528.0, 639.0, 741.0, 852.0, 936.0, 963.0
];

public let SCHUMANN_HARMONICS : [Float] = [7.83, 14.1, 20.3, 26.4, 32.4, 39.0, 45.0];

public let SOLFEGGIO : [Float] = [174.0, 285.0, 396.0, 417.0, 528.0, 639.0, 741.0, 852.0, 963.0];

// Generate vibration
public func generateVibration(frequencies: [Float], amplitudes: [Float], time: Float) : Float {
    var vibration : Float = 0.0;
    for (i in frequencies.keys()) {
        vibration += amplitudes[i] * Float.sin(2.0 * PI * frequencies[i] * time);
    };
    return vibration;
};
```

