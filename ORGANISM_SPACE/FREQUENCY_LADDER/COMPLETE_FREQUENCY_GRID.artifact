```
// Frequency constants for Motoko

public let FREQ_GRID : [Float] = [
    // Sub-hertz
    0.05, 0.1, 0.15, 0.2, 0.3, 0.5,
    // Delta
    0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5,
