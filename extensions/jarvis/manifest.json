{
  "manifest_version": 3,
  "name": "JARVISIUS — Sovereign Intelligence Assistant",
  "version": "2.0.0",
  "description": "Your sovereign AI assistant. Controls tabs, takes notes, creates documents, captures pages, reads pages aloud, bookmarks, history, timers, calculations, translations — all synced to MERIDIAN. By Alfredo Medina Hernandez.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel",
    "scripting",
    "bookmarks",
    "history",
    "alarms",
    "tts",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.medinatech.io/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open JARVISIUS",
    "default_icon": {
      "16": "icons/jarvis-16.png",
      "48": "icons/jarvis-48.png",
      "128": "icons/jarvis-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/jarvis-16.png",
    "48": "icons/jarvis-48.png",
    "128": "icons/jarvis-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+J", "mac": "Command+Shift+J" },
      "description": "Open JARVISIUS"
    },
    "quick-note": {
      "suggested_key": { "default": "Ctrl+Shift+N", "mac": "Command+Shift+N" },
      "description": "Quick Note from selection"
    },
    "quick-capture": {
      "suggested_key": { "default": "Ctrl+Shift+C", "mac": "Command+Shift+C" },
      "description": "Capture current page"
    }
  }
}
