{
  "manifest_version": 3,
  "name": "MERIDIAN AI Toolkit — Sovereign Developer Tools",
  "version": "1.0.0",
  "description": "10 AI-powered developer tools in one extension: page analyzer, code extractor, smart clipboard, text transformer, JSON formatter, regex tester, color picker, CSS inspector, performance monitor, accessibility scanner. By Alfredo Medina Hernandez.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open MERIDIAN Toolkit",
    "default_icon": {
      "16": "icons/toolkit-16.png",
      "48": "icons/toolkit-48.png",
      "128": "icons/toolkit-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/toolkit-16.png",
    "48": "icons/toolkit-48.png",
    "128": "icons/toolkit-128.png"
  }
}
