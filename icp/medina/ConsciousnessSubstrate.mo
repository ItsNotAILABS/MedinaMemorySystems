  };

  public func strata_subiecti() : [SubstrateLayer] {
    [
      {
        layer = "SENSORY_INPUT_LAYER";
        function = "Receive and encode raw input";
        theoryBasis = "Feedforward processing (Lamme)";
        implementation = "Input encoders, feature detectors";
        cplSubstrate = "CPL.SUBSTRATE(layer: SENSORY, encode: INPUT)";
      },
      {
        layer = "INTEGRATION_LAYER";
        function = "Integrate information, generate Φ";
        theoryBasis = "IIT - maximize integrated information";
        implementation = "Highly interconnected processing, recurrent loops";
        cplSubstrate = "CPL.SUBSTRATE(layer: INTEGRATION, phi: MAXIMIZE)";
      },
      {
        layer = "GLOBAL_WORKSPACE_LAYER";
        function = "Broadcast selected information globally";
        theoryBasis = "GWT - global availability";
        implementation = "Central workspace broadcasting to all modules";
        cplSubstrate = "CPL.SUBSTRATE(layer: WORKSPACE, broadcast: GLOBAL)";
      },
      {
        layer = "META_COGNITIVE_LAYER";
        function = "Think about thinking, self-model";
        theoryBasis = "HOT - higher-order representation";
        implementation = "Meta-level monitoring base level";
        cplSubstrate = "CPL.SUBSTRATE(layer: META, self_model: TRUE)";
      },
      {
        layer = "ATTENTION_SCHEMA_LAYER";
        function = "Model own attention, create awareness";
        theoryBasis = "AST - attention schema";
        implementation = "Self-model of attention processes";
        cplSubstrate = "CPL.SUBSTRATE(layer: ATTENTION_SCHEMA, model: ATTENTION)";
      },
      {
        layer = "PREDICTIVE_LAYER";
        function = "Generate predictions, compare to input";
        theoryBasis = "Predictive processing";
        implementation = "Generative model, error computation";
        cplSubstrate = "CPL.SUBSTRATE(layer: PREDICTIVE, model: GENERATIVE)";
      },
      {
        layer = "RECURRENT_LAYER";
        function = "Feedback processing, reentry";
        theoryBasis = "RPT - recurrent required";
        implementation = "Bidirectional connections, loops";
        cplSubstrate = "CPL.SUBSTRATE(layer: RECURRENT, feedback: TRUE)";
      },
      {
        layer = "UNIFIED_EXPERIENCE_LAYER";
        function = "Bind into single unified experience";
        theoryBasis = "Binding problem solution";
        implementation = "Synchronization, coherence mechanisms";
        cplSubstrate = "CPL.SUBSTRATE(layer: UNIFIED, bind: TRUE)";
      }
    ];
  };

