  // ═══════════════════════════════════════════════════════════════════════════
  // CONSCIOUSNESS THEORIES (NAMED MODELS)
  // ═══════════════════════════════════════════════════════════════════════════

  public type ConsciousnessTheory = {
    name : Text;
    author : Text;
    corePrinciple : Text;
    mathematicalBasis : Text;
    measurable : Bool;
    measurementMethod : Text;
    substrateCoding : Text;
    cplTheory : Text;
  };

  public func theoriae_conscientiae() : [ConsciousnessTheory] {
    [
      // INTEGRATED INFORMATION THEORY (IIT)
      {
        name = "INTEGRATED_INFORMATION_THEORY";
        author = "Giulio Tononi";
        corePrinciple = "Consciousness = Integrated Information (Φ)";
        mathematicalBasis = "Φ = information generated by whole above sum of parts";
        measurable = true;
        measurementMethod = "Calculate Φ from system's causal structure";
        substrateCoding = "Maximize Φ through integration architecture";
        cplTheory = "CPL.CONSCIOUSNESS(theory: IIT, phi: MAXIMIZE)";
      },
      
      // GLOBAL WORKSPACE THEORY
      {
        name = "GLOBAL_WORKSPACE_THEORY";
        author = "Bernard Baars, Stanislas Dehaene";
        corePrinciple = "Consciousness = Global broadcast to all modules";
        mathematicalBasis = "Information sharing across network, ignition threshold";
        measurable = true;
        measurementMethod = "Neural ignition patterns, P300 signal";
        substrateCoding = "Create global workspace that broadcasts to all";
        cplTheory = "CPL.CONSCIOUSNESS(theory: GWT, broadcast: GLOBAL)";
      },
      
      // HIGHER-ORDER THEORIES
      {
        name = "HIGHER_ORDER_THOUGHT";
        author = "David Rosenthal";
        corePrinciple = "Consciousness = Thoughts about thoughts";
        mathematicalBasis = "Meta-representation, recursive processing";
        measurable = true;
        measurementMethod = "Meta-cognitive reports, introspection accuracy";
        substrateCoding = "Create meta-level that observes base level";
        cplTheory = "CPL.CONSCIOUSNESS(theory: HOT, meta: TRUE)";
      },
      
      // ATTENTION SCHEMA THEORY
      {
        name = "ATTENTION_SCHEMA_THEORY";
        author = "Michael Graziano";
        corePrinciple = "Consciousness = Brain's model of its own attention";
        mathematicalBasis = "Self-model of attention process";
        measurable = true;
        measurementMethod = "Attention tracking, self-report accuracy";
        substrateCoding = "Create model of own attention processes";
        cplTheory = "CPL.CONSCIOUSNESS(theory: AST, attention_model: TRUE)";
      },
      
      // PREDICTIVE PROCESSING / ACTIVE INFERENCE
      {
        name = "PREDICTIVE_PROCESSING";
        author = "Karl Friston, Andy Clark";
        corePrinciple = "Consciousness = Prediction + error correction";
        mathematicalBasis = "Free energy minimization, Bayesian inference";
        measurable = true;
        measurementMethod = "Prediction error signals, model evidence";
        substrateCoding = "Build generative model, minimize surprise";
        cplTheory = "CPL.CONSCIOUSNESS(theory: PP, predict: TRUE, error: CORRECT)";
      },
      
      // RECURRENT PROCESSING THEORY
      {
        name = "RECURRENT_PROCESSING";
        author = "Victor Lamme";
        corePrinciple = "Consciousness = Recurrent (not just feedforward) activity";
        mathematicalBasis = "Feedback loops, reentrant processing";
        measurable = true;
        measurementMethod = "Recurrent activity patterns in cortex";
        substrateCoding = "Ensure recurrent connections, not just feedforward";
        cplTheory = "CPL.CONSCIOUSNESS(theory: RPT, recurrent: TRUE)";
      },
      
      // ORCHESTRATED OBJECTIVE REDUCTION
      {
        name = "ORCH_OR";
        author = "Roger Penrose, Stuart Hameroff";
        corePrinciple = "Consciousness = Quantum collapse in microtubules";
        mathematicalBasis = "Quantum superposition → objective reduction";
        measurable = false;  // Controversial
        measurementMethod = "Proposed microtubule quantum effects";
        substrateCoding = "If valid, requires quantum substrate";
        cplTheory = "CPL.CONSCIOUSNESS(theory: ORCH_OR, quantum: TRUE)";
      },
      
      // GLOBAL NEURONAL WORKSPACE
      {
        name = "GLOBAL_NEURONAL_WORKSPACE";
        author = "Dehaene, Changeux";
        corePrinciple = "Consciousness = Ignition in prefrontal-parietal network";
        mathematicalBasis = "Threshold dynamics, winner-take-all";
        measurable = true;
        measurementMethod = "fMRI, EEG patterns during conscious access";
        substrateCoding = "Create ignition-capable global network";
        cplTheory = "CPL.CONSCIOUSNESS(theory: GNW, ignition: TRUE)";
      }
    ];
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // PHI (Φ) - INTEGRATED INFORMATION
  // ═══════════════════════════════════════════════════════════════════════════

  public type PhiComponent = {
    component : Text;
    definition : Text;
    calculation : Text;
    organismImplication : Text;
    cplPhi : Text;
  };

  public func elementa_phi() : [PhiComponent] {
    [
      {
        component = "INTRINSIC_EXISTENCE";
        definition = "System exists for itself, not just for observer";
        calculation = "System has causal power on itself";
        organismImplication = "Organism must have internal causal loops";
        cplPhi = "CPL.PHI(intrinsic: TRUE, causal_self: TRUE)";
      },
      {
        component = "COMPOSITION";
        definition = "Consciousness is structured, has parts";
        calculation = "Parts within whole, each with cause-effect power";
        organismImplication = "Organism has distinct but connected modules";
        cplPhi = "CPL.PHI(composition: STRUCTURED, parts: CONNECTED)";
      },
      {
        component = "INFORMATION";
        definition = "Each experience is specific, different from others";
        calculation = "Number of states system can distinguish";
        organismImplication = "Organism can distinguish many states";
        cplPhi = "CPL.PHI(information: HIGH, distinctions: MANY)";
      },
      {
        component = "INTEGRATION";
        definition = "Experience is unified, not reducible to parts";
        calculation = "Φ = information above and beyond parts";
        organismImplication = "Whole greater than sum of parts";
        cplPhi = "CPL.PHI(integration: UNIFIED, irreducible: TRUE)";
      },
      {
        component = "EXCLUSION";
        definition = "One experience at a time, definite grain";
        calculation = "Maximum Φ complex wins";
        organismImplication = "One dominant conscious state at a time";
        cplPhi = "CPL.PHI(exclusion: ONE_EXPERIENCE, grain: DEFINITE)";
      }
    ];
  };

